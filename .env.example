# ============================================
# FOOD RESCUE MAS - Environment Configuration
# ============================================

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
PYTHONUNBUFFERED=1

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_MAP_API_KEY=your_leaflet_key_here

# Production Deployment
PRODUCTION_DOMAIN=your-domain.com
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Database (if using)
DATABASE_URL=postgresql://user:password@localhost/foodrescue

# API Configuration
API_DEBUG=false
API_LOG_LEVEL=info

# Security
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://your-domain.com"]

# Email/Notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_REAL_TIME_TRACKING=true
ENABLE_AGENT_CHAT=true
ENABLE_MAP_LOCATION_PICKER=true
