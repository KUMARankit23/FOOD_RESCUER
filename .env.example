# ============================================
# FOOD RESCUE MAS - Environment Configuration
# ============================================

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
PYTHONUNBUFFERED=1

# LLM Configuration
LLM_PROVIDER=google_gemini  # Options: google_gemini, anthropic, ollama
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# Database Configuration
DATABASE_URL=sqlite:///./food_rescue.db
# For PostgreSQL: postgresql://user:password@localhost/food_rescue
SQL_ECHO=false

# RAG Configuration
RAG_PERSIST_DIR=./chroma_data
RAG_SIMILARITY_THRESHOLD=0.3

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_MAP_API_KEY=your_leaflet_key_here

# Production Deployment
PRODUCTION_DOMAIN=your-domain.com
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# API Configuration
API_DEBUG=false
API_LOG_LEVEL=info

# Security
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://your-domain.com"]

# Email/Notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Monitoring & Observability
OPENTELEMETRY_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Feature Flags
ENABLE_REAL_TIME_TRACKING=true
ENABLE_AGENT_CHAT=true
ENABLE_MAP_LOCATION_PICKER=true
ENABLE_LLM_REASONING=true
ENABLE_RAG_RETRIEVAL=true
ENABLE_MCP_TOOLS=true
